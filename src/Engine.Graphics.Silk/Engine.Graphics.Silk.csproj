    <EmbeddedResource Include="../Shaders/grid.frag.spv" LogicalName="grid.frag.spv" />
    <EmbeddedResource Include="../Shaders/skybox.vert.spv" LogicalName="skybox.vert.spv" />
    <EmbeddedResource Include="../Shaders/skybox.frag.spv" LogicalName="skybox.frag.spv" />
    <EmbeddedResource Include="../Shaders/model.vert.spv" LogicalName="model.vert.spv" />
    <EmbeddedResource Include="../Shaders/model.frag.spv" LogicalName="model.frag.spv" />
