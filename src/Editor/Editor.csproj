<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../tools/Engine.Profiler.Weaver/Engine.Profiler.Weaver.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../../tools/Engine.Script.Generator/Engine.Script.Generator.csproj"
                      ReferenceOutputAssembly="false" PrivateAssets="all" />
    <ProjectReference Include="../Engine.Assets/Engine.Assets.csproj" />
    <ProjectReference Include="../Engine.Graphics/Engine.Graphics.csproj" />
    <ProjectReference Include="../Engine.Graphics.Silk/Engine.Graphics.Silk.csproj" />
    <ProjectReference Include="../Engine.Physics/Engine.Physics.csproj" />
    <ProjectReference Include="../Engine.Scripting/Engine.Scripting.csproj" />
    <ProjectReference Include="../Engine.UI/Engine.UI.csproj" />
  </ItemGroup>

  <Target Name="CopyScriptGenerator" AfterTargets="Build">
    <Copy SourceFiles="$(MSBuildProjectDirectory)/../../tools/Engine.Script.Generator/bin/$(Configuration)/netstandard2.0/Engine.Script.Generator.dll"
          DestinationFolder="$(TargetDir)" />
  </Target>

  <PropertyGroup>
    <EnableManagedProfilerInstrumentation Condition="'$(EnableManagedProfilerInstrumentation)' == '' and '$(Configuration)' == 'Debug'">true</EnableManagedProfilerInstrumentation>
  </PropertyGroup>

  <Target Name="InstrumentManagedProfilerAssemblies" AfterTargets="Build"
          Condition="'$(EnableManagedProfilerInstrumentation)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <ProfilerWeaver>$(MSBuildProjectDirectory)/../../tools/Engine.Profiler.Weaver/bin/$(Configuration)/net11.0/Engine.Profiler.Weaver.dll</ProfilerWeaver>
    </PropertyGroup>
    <Exec Command="dotnet &quot;$(ProfilerWeaver)&quot; &quot;$(TargetDir)Engine.Graphics.dll&quot; &quot;$(TargetDir)Engine.Graphics.dll&quot; &quot;$(TargetDir)Engine.Graphics.Silk.dll&quot; &quot;$(TargetDir)Engine.UI.dll&quot; &quot;$(TargetPath)&quot;" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.10" />
  </ItemGroup>

</Project>
